{
  "name": "mlb-prop-analyzer-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "check:scripts": "node --check scripts/clean.mjs && node --check scripts/provider-probe-utils.mjs && node --check scripts/provider-capability-utils.mjs && node --check scripts/verify-provider-access.mjs && node --check scripts/capture-provider-capabilities.mjs && node --check scripts/m8-recency-weighting-utils.mjs && node --check scripts/capture-m8-current-season-pa.mjs && node --check scripts/m8-capture-verification-utils.mjs && node --check scripts/verify-m8-current-season-pa.mjs && node --check scripts/m8-sharded-capture-utils.mjs && node --check scripts/capture-m8-current-season-pa-shards.mjs",
    "build": "tsc",
    "architecture": "depcruise --config .dependency-cruiser.cjs src test --exclude '^test/architecture/fixtures/'",
    "test:selected-side": "node --test dist/test/selected-side.test.js",
    "test:architecture-protective": "node --test dist/test/architecture-boundaries.test.js",
    "test:provider-probe-utils": "node --test test/provider-probe-utils.test.mjs",
    "test:provider-capability-utils": "node --test test/provider-capability-utils.test.mjs",
    "test:m8-recency": "node --test test/m8-recency-weighting-utils.test.mjs",
    "test:m8-capture-verification": "node --test test/m8-capture-verification.test.mjs",
    "test:m8-sharded-capture": "node --test test/m8-sharded-capture.test.mjs",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "verify": "npm run typecheck && npm run check:scripts && npm run architecture && npm test",
    "verify:provider-access": "node scripts/verify-provider-access.mjs",
    "capture:provider-capabilities": "node scripts/capture-provider-capabilities.mjs",
    "capture:m8-current-season-pa": "node scripts/capture-m8-current-season-pa.mjs",
    "verify:m8-current-season-pa": "node scripts/verify-m8-current-season-pa.mjs",
    "capture:m8-current-season-pa-shards": "node scripts/capture-m8-current-season-pa-shards.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "dependency-cruiser": "17.4.3",
    "typescript": "5.9.3"
  }
}
