function run(command, args) {
  return execFileSync(command, args, { encoding: 'utf8' }).trim();
}
function replaceOnce(text, needle, replacement, label) {
  const first = text.indexOf(needle);
  if (first < 0 || text.indexOf(needle, first + needle.length) >= 0) {
    throw new Error(`${label}: expected exactly one match.`);
  }
  return text.slice(0, first) + replacement + text.slice(first + needle.length);
}
function appendOnce(text, marker, addition, label) {
  if (text.includes(marker)) throw new Error(`${label}: marker already exists.`);
  return `${text.trimEnd()}\n\n${addition.trim()}\n`;
}

if (run('git', ['branch', '--show-current']) !== BRANCH) throw new Error(`Expected branch ${BRANCH}.`);
