 => left.periodId.localeCompare(right.periodId) || left.cellKey.localeCompare(right.cellKey),
    ),
  );
  return Object.freeze({
    normalization: 'normalizedPitcherHand is retained only when exactly L or R; every other value, including the string null, becomes the null literal',
    platoonGate: 'platoon deviation is applied only when batter side and pitcher hand are each exactly L or R',
    fit,
    validation,
    exceedingVenueHandCellCount: affected.length,
    exceedingVenueHandCells: affected,
  });
}

export class M8ParkPitcherHandClusteringError extends Error {
  constructor(diagnostics) {
    const affected = diagnostics.exceedingVenueHandCells
      .map((cell) => \`${cell.periodId}:${cell.cellKey}=${cell.nullPitcherHandPercentage.toFixed(6)}% (threshold ${cell.thresholdPercentage.toFixed(6)}%)\`)
      .join(', ');
    super(\`park candidate fitting stopped because ${diagnostics.exceedingVenueHandCellCount} venue|batterHand cell(s) exceed twice the period null-pitcher-hand rate: ${affected}\`);
    this.name = 'M8ParkPitcherHandClusteringError';
    this.code = 'M8_PARK_NULL_PITCHER_HAND_CLUSTERING';
    this.pitcherHandAvailability = diagnostics;
  }
}

function assertNoPitcherHandClustering(diagnostics) {
  if (diagnostics.exceedingVenueHandCellCount > 0) {
    throw new M8ParkPitcherHandClusteringError(diagnostics);
  }
}
