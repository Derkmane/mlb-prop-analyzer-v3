modules = ["nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
build = "node scripts/verify-deployment-display-freshness.mjs && npm run build"
run = "node dist/src/composition/hhr-display-server.js"
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
